{
  "name": "hilbras-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:client && pnpm build:server && pnpm validate && pnpm seo && pnpm prerender",
    "build:client": "vite build",
    "build:server": "vite build --mode ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seo": "node scripts/generate-seo.mjs",
    "validate": "node scripts/validate-data.mjs",
    "serve:headers": "node scripts/serve-with-headers.mjs",
    "verify:validator": "node scripts/verify-validator.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
